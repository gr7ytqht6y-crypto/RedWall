# ==========================================
# RedWall — Git Ignore
# ==========================================

# Operating system files
.DS_Store
Thumbs.db
Desktop.ini

# IDE and editor files
.vscode/
.idea/
*.swp
*.swo

# Logs
*.log
logs/

# Environment variables and secrets
.env
.env.local
.env.development
.env.production
.env.test
*.env

# Node.js
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Build outputs
dist/
build/
out/
.next/
.nuxt/
.cache/
.tmp/
temp/

# Coverage
coverage/
.nyc_output/

# Python
__pycache__/
*.py[cod]
*.pyo
.pytest_cache/
.venv/
venv/
env/

# Local databases
*.db
*.sqlite
*.sqlite3

# Temporary files
*.tmp
*.temp
*.bak
*.swp

# OS/editor metadata
.DS_Store
